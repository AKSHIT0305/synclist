# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- App (bundled into the app; EXPO_PUBLIC_* values are NOT secret) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Google Cloud "Web application" OAuth client id (also configured in Supabase > Auth > Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Phone OTP needs a paid SMS provider; keep false until one is configured in Supabase.
EXPO_PUBLIC_ENABLE_PHONE_OTP=false

# --- Build config (read by app.config.ts at build time) ---
# Optional override. app.config.ts already points at the shared @synclist/synclist EAS project.
EAS_PROJECT_ID=
# Only needed once iOS is set up (reversed iOS client id)
GOOGLE_IOS_URL_SCHEME=

# --- Server-side / scripts only (SECRET — never prefix with EXPO_PUBLIC_) ---
# Used by scripts/seed.ts. Point at the DEV project only.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for scripts/run-sql-tests.ts (Session pooler URI from
# Supabase > Connect). Tests run inside BEGIN/ROLLBACK and leave no data behind.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
